<mvc:View
    controllerName="productsreport.controller.ListReport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%"
>
    <f:DynamicPage
        id="ListReport"
        headerExpanded="{/headerExpanded}"
        toggleHeaderOnTitleClick="{/titleClickable}"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>productsTable}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <fb:FilterBar
                        useToolbar="false"
                        showClearOnFB="true"
                        showGoOnFB="false"
                        clear="onClearPress"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                name="Name"
                                label="{i18n>productName}"
                                groupName="productFilter"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <SearchField
                                        id='searchFieldProducts'
                                        width="90%"
                                        liveChange="onSearchAction"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="Status"
                                label="{i18n>status}"
                                groupName="productFilter"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <MultiComboBox
                                        id="comboBoxProducts"
                                        width="90%"
                                        selectionChange='onSearchAction'
                                        items="{viewModel>/statusTypes}"
                                    >
                                        <core:Item
                                            key="{= ${viewModel>} === 'OUT_OF_STOCK' ? 'OUT_OF_STOCK' : ${viewModel>} === 'OK' ? 'OK' : ${viewModel>} === 'STORAGE' ? 'STORAGE' : 'NONE'}"
                                            text="{= ${viewModel>} === 'OUT_OF_STOCK' ? ${i18n>outOfStock} : ${viewModel>} === 'OK' ? ${i18n>ok} : ${viewModel>} === 'STORAGE' ? ${i18n>storage} : ${i18n>none}}"
                                        />
                                    </MultiComboBox>
                                </fb:control>
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem
                                name="Producer"
                                label="{i18n>producer}"
                                groupName="productFilter"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <SearchField
                                        liveChange="onSearchAction"
                                        id="searchFieldMadeIn"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                            <fb:FilterGroupItem
                                name="Rating"
                                label="{i18n>rating}"
                                groupName="productFilter"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <RatingIndicator
                                        iconSize="1rem"
                                        change="onSearchAction"
                                        id="ratingProducts"
                                        maxValue="5"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox>
                <HBox
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <Title
                        core:require="{Formatter: 'productsreport/utils/formatter'}"

                        text="{
                        parts: ['i18n>productsCount', 'viewModel>/productsCount'],
                        formatter: 'Formatter.formatProductsCount'}"
                        level="H2"
                    />

                    <HBox>
                        <Button
                            id='deleteProductBtn'
                            text="{i18n>delete}"
                            enabled="false"
                            press="onDeleteProducts"
                        />
                        <Button
                            text="{i18n>create}"
                            class="sapUiTinyMarginBegin"
                            press="onCreateProduct"
                        />
                    </HBox>
                </HBox>

                <Table
                    id="idProductsTable"
                    sticky="HeaderToolbar,ColumnHeaders"
                    mode="MultiSelect"
                    inset="false"
                    updateFinished="onProductsTableUpdateFinished"
                    items="{
                							path: '/Products',
                              factory: '.createContentProducts',
	                						sorter: {
	                							path: 'Name'
	                						},
                             parameters: {
                             operationMode: 'Server'
                             }        
		                				}"
                    class="sapFDynamicPageAlignContent"
                    width="auto"
                    selectionChange="onSelectionChange"
                >
                    <columns>
                        <Column width="12em">
                            <Text text="{i18n>productName}" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="{i18n>specs}" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            hAlign='Center'
                        >
                            <Text text="{i18n>rating}" />
                        </Column>

                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="{i18n>supplierInfo}" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="{i18n>madeIn}" />
                        </Column>

                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="{i18n>producer}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{i18n>price}" />
                        </Column>
                        <Column>
                            <Text text="{i18n>status}" />
                        </Column>
                    </columns>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
